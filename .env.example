# Copy this file to .env and fill in real values when you're ready to
# send real emails from the contact form instead of just logging them.
# .env is listed in .gitignore so your real secrets never get committed.

PORT=3000

# Example if you later add Nodemailer with a Gmail account:
# EMAIL_USER=info@zygotedigitals.com
# EMAIL_PASS=your_app_password_here
