# Copy this file to .env and fill in real values for LOCAL testing only.
# .env is listed in .gitignore so your real secrets never get committed.
# On Render, you set these same names under Settings -> Environment
# instead of using a .env file (Render doesn't read .env files at all).

PORT=3000

# The Gmail account that will SEND the notification email.
# Use a Gmail "App Password" here, NOT your normal Gmail password.
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=your_16_character_app_password

# Where contact form submissions get delivered TO. Can be the same as
# EMAIL_USER, or a different inbox (e.g. once info@zygotedigitals.com
# is set up, just change this one value).
NOTIFY_EMAIL=youraccount@gmail.com
